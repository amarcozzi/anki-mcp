# Copy to .env (git-ignored). Load with:  set -a; source .env; set +a
ANKIWEB_USERNAME=you@example.com
ANKIWEB_PASSWORD=
# What you type on the OAuth consent page when connecting from claude.ai
OWNER_PASSWORD=
# openssl rand -base64 48
JWT_SIGNING_KEY=
# Public URL of this server (no trailing slash)
BASE_URL=https://anki-mcp-xxxx.run.app
# Where the disposable collection copy lives (in-memory on Cloud Run)
COLLECTION_DIR=/tmp/anki-mcp
# Optional: extra OAuth redirect URIs, comma-separated (e.g. MCP Inspector)
# EXTRA_REDIRECT_URIS=http://localhost:6274/oauth/callback
