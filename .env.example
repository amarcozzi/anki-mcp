# Copy to .env (git-ignored) for local runs: set -a; source .env; set +a
ANKIWEB_USERNAME=you@example.com
ANKIWEB_PASSWORD=
# What you type on the OAuth consent page when connecting from claude.ai
OWNER_PASSWORD=
# openssl rand -base64 48
JWT_SIGNING_KEY=
# Public URL of this server (no trailing slash). Locally use a tunnel URL.
BASE_URL=https://anki-mcp-xxxx.run.app
# Optional: extra OAuth redirect URIs, comma-separated (e.g. for MCP Inspector)
# EXTRA_REDIRECT_URIS=http://localhost:6274/oauth/callback
